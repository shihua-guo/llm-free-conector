APP_NAME=llm-free-conector
APP_ENV=local
LOG_LEVEL=INFO
APP_PORT=8000

# PostgreSQL. Use postgresql+asyncpg for the async SQLAlchemy engine.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_free_connector

# Optional bearer token required by this service. Leave empty to disable auth.
CONNECTOR_API_KEY=

# NewAPI admin endpoints used for channel/model sync.
NEWAPI_BASE_URL=http://new-api:3000
NEWAPI_ADMIN_TOKEN=
NEWAPI_USER_ID=
NEWAPI_CHANNEL_LIST_PATH=/api/channel/
NEWAPI_FETCH_CHANNEL_MODELS_PATH=/api/channel/fetch_models/{channel_id}
NEWAPI_CHANNEL_MODELS_PATH=/api/channel/models

# NewAPI OpenAI-compatible relay key. If empty, falls back to NEWAPI_ADMIN_TOKEN.
NEWAPI_API_KEY=

SYNC_INTERVAL_SECONDS=900
SYNC_ON_STARTUP=true
ENABLE_BACKGROUND_SYNC=true
HTTP_TIMEOUT_SECONDS=60
RETRY_STATUS_CODES=429,500,502,503,504
